# ============================================================
# Everest local-PROD env template
# ============================================================
# Copy to `.env.local-prod` and fill in. Used ONLY by
# docker-compose.local-prod.yml. Your dev `.env` is unaffected.
#
# Bring up:
#   docker compose -f docker-compose.local-prod.yml --env-file .env.local-prod up -d --build
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
# Generate with: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS

# Pick a strong password. The default in docker-compose is intentionally
# bogus to force you to do this.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PG_PASSWORD

# ── AI providers (at least one) ──────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── TLS hostnames in the self-signed cert ────────────────────
# Comma-separated. Add any extra dev/test hostnames you'll use.
TLS_HOSTS=localhost,127.0.0.1,everest.local

# ── Optional ────────────────────────────────────────────────
# Public URL used in invitation emails.
EVEREST_PUBLIC_URL=https://localhost:8443
# Postgres user/db (defaults to "everest"/"everest" if omitted).
POSTGRES_USER=everest
POSTGRES_DB=everest
# CORS — for this same-origin stack you almost never need to change it.
CORS_ORIGINS=https://localhost:8443
# Sentry — leave blank for local-prod.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local-prod
# Rate limits (per hour)
EVEREST_RATE_LIMIT_LLM_PER_HOUR=30
# Logging
LOG_LEVEL=INFO

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP (leave blank to use the manual-paste invite flow)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Override published proxy ports if 8080/8443 are in use.
PROXY_HTTPS_PORT=8443
PROXY_HTTP_PORT=8080
