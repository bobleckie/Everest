# ============================================================
# Everest backend — environment variable template
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is in .gitignore).
#
# Generate any secret/key with:
#   py -c "import secrets; print(secrets.token_hex(32))"
#
# After editing, restart the FastAPI process to pick up changes.
# ============================================================

# ── Database ────────────────────────────────────────────────
# Default: local SQLite file in the workspace root.
DATABASE_URL=sqlite:///./rfp.db
# Production / shared (uncomment when migrating):
# DATABASE_URL=postgresql+psycopg://rfp_user:STRONG_PASSWORD@localhost:5432/rfp_db

# ── AI Providers ────────────────────────────────────────────
# At least one is required for LLM-backed features. Without
# either, AI calls degrade to mock responses (logged warning).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── JWT / Auth ──────────────────────────────────────────────
# REQUIRED. The placeholder string below is rejected at startup —
# generate with `secrets.token_hex(32)`.
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
ALGORITHM=HS256
# 480 minutes = 8 hours. Once the frontend uses /api/auth/refresh
# (todo #8 frontend follow-up), shorten this to ~15 for tighter
# session security; UX won't regress because tokens auto-rotate.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# How long a refresh token is valid (in days). Each refresh rotates
# this — using a refresh token revokes it and mints a new one.
# Replay of a revoked token triggers chain-wide revocation.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── User invitations (#17) ───────────────────────────────────
# Public URL used in invitation emails. Set this in pilot/prod to
# the URL your users actually open the app at.
EVEREST_PUBLIC_URL=http://localhost:3000

# How long a new-user invitation is valid (in days).
INVITE_EXPIRE_DAYS=7

# ── SMTP for invitation emails (optional) ───────────────────
# When SMTP_HOST is unset, invitations still work — the API just
# returns the redeem URL so the admin pastes it manually. Set the
# rest of these to enable automatic email delivery.
# SMTP_HOST=smtp.parsons.com
# SMTP_PORT=587
# SMTP_USERNAME=everest@parsons.com
# SMTP_PASSWORD=
# SMTP_FROM=everest@parsons.com
# SMTP_USE_TLS=true

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. NEVER use
# "*" in any shared environment — it is unsafe with credentialed
# requests. For local dev, the CRA dev server uses port 3000.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Feature flags ───────────────────────────────────────────
# DEBUG=true enables a `dev-bypass-token` that auto-logs in as the
# first admin without a password. ONLY enable on a developer
# machine — never on a shared host.
DEBUG=false

# Logging verbosity for the backend (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO

# ── Networking / TLS ────────────────────────────────────────
# Corp networks with TLS inspection break outbound HTTPS to
# Anthropic / OpenAI. Set to 0 to disable cert verification on
# outbound LLM calls (last resort — prefer setting REQUESTS_CA_BUNDLE
# to the corp root CA bundle when possible). The DB-level
# `app_settings.ssl_verify=false` row also achieves this.
# EVEREST_SSL_VERIFY=0
# REQUESTS_CA_BUNDLE=C:\path\to\corp-root-ca.pem

# ── Data directories ────────────────────────────────────────
# Each defaults to a sibling folder of the app code. Override
# individually, OR set EVEREST_DATA_DIR to put all three under
# one mounted volume (the deploy-friendly option).
# EVEREST_DATA_DIR=D:\everest-data
# EVEREST_UPLOADS_DIR=D:\everest-data\uploads
# EVEREST_CHROMA_DIR=D:\everest-data\chroma_db
# EVEREST_LOGS_DIR=D:\everest-data\logs

# ── Error reporting (Sentry) ────────────────────────────────
# OPTIONAL. When SENTRY_DSN is set, unhandled exceptions are sent to
# Sentry for triage. Without it, the SDK is a silent no-op.
# Get a DSN at https://sentry.io/  (free tier is plenty for this app).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development            # set "pilot" or "production" in deploys
# SENTRY_RELEASE=                           # auto-detected if blank
# SENTRY_TRACES_SAMPLE_RATE=0.0             # 0..1 — perf tracing (off by default)
# SENTRY_SEND_DEFAULT_PII=false             # never auto-attach IPs/cookies/bodies

# ── Per-user rate limits ────────────────────────────────────
# All values are "max calls per hour". Admins always bypass.
# EVEREST_RATE_LIMIT_LLM_PER_HOUR=30
# EVEREST_RATE_LIMIT_LLM_VENDOR_PER_HOUR=10
# EVEREST_RATE_LIMIT_LLM_EVALUATOR_PER_HOUR=10

# ── Backups ─────────────────────────────────────────────────
# Where backup_db.ps1 writes daily SQLite snapshots.
EVEREST_BACKUP_DEST=C:\Users\<you>\OneDrive - Parsons Corp\Everest Backup
